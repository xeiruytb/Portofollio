@import url("https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800;900&display=swap");
@import "tailwindcss";

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #000;
  color-scheme: dark;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.font-serif-display {
  font-family: "Instrument Serif", "Times New Roman", serif;
  font-weight: 400;
  letter-spacing: -0.02em;
}

/* ─── Animated Aurora Blobs ────────────────────────────────────────────────── */
@keyframes blob-drift-1 {
  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.25; }
  33%      { transform: translate(6%, -8%) scale(1.15); opacity: 0.4; }
  66%      { transform: translate(-5%, 5%) scale(0.9); opacity: 0.2; }
}
@keyframes blob-drift-2 {
  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.35; }
  33%      { transform: translate(-8%, 6%) scale(1.1); opacity: 0.5; }
  66%      { transform: translate(6%, -4%) scale(0.85); opacity: 0.25; }
}
@keyframes blob-drift-3 {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.1; }
  50%      { transform: translate(-50%, -50%) scale(1.25); opacity: 0.2; }
}

.blob-1 { animation: blob-drift-1 20s ease-in-out infinite; }
.blob-2 { animation: blob-drift-2 26s ease-in-out infinite; }
.blob-3 { animation: blob-drift-3 18s ease-in-out infinite; }

/* ─── SVG Grain Overlay ────────────────────────────────────────────────────── */
.noise-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.05;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

/* ─── Subtle Scanlines ─────────────────────────────────────────────────────── */
.scanlines {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.02;
  background: repeating-linear-gradient(
    0deg,
    transparent 0px,
    transparent 2px,
    rgba(255, 255, 255, 0.5) 2px,
    rgba(255, 255, 255, 0.5) 3px
  );
}

/* ─── Holographic Border Shine ─────────────────────────────────────────────── */
@keyframes shine {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.holo-border {
  position: relative;
}
.holo-border::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(
    100deg,
    transparent 30%,
    rgba(248, 62, 62, 0.5) 45%,
    rgba(248, 186, 186, 0.6) 50%,
    rgba(248, 124, 124, 0.5) 55%,
    transparent 70%
  );
  background-size: 200% 100%;
  animation: shine 6s linear infinite;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
          mask-composite: exclude;
  pointer-events: none;
}

/* ─── Marquee ──────────────────────────────────────────────────────────────── */
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

.marquee-track {
  animation: marquee 30s linear infinite;
}

.marquee-mask {
  -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
          mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
}

/* ─── Pulsing Status Ring ──────────────────────────────────────────────────── */
@keyframes pulse-ring {
  0%   { box-shadow: 0 0 0 0 rgba(248, 62, 62, 0.6); }
  70%  { box-shadow: 0 0 0 10px rgba(248, 62, 62, 0); }
  100% { box-shadow: 0 0 0 0 rgba(248, 62, 62, 0); }
}

.status-ring {
  animation: pulse-ring 2.4s cubic-bezier(0.66, 0, 0, 1) infinite;
}

/* ─── Floating Embers ──────────────────────────────────────────────────────── */
@keyframes float-up {
  0%   { transform: translateY(100vh) translateX(0); opacity: 0; }
  8%   { opacity: 1; }
  50%  { transform: translateY(50vh) translateX(var(--drift, 10px)); }
  92%  { opacity: 0.7; }
  100% { transform: translateY(-8vh) translateX(calc(var(--drift, 10px) * 2)); opacity: 0; }
}

.ember {
  position: absolute;
  border-radius: 9999px;
  background: radial-gradient(circle, #ffffff 0%, #f8baba 30%, #f83e3e 60%, transparent 100%);
  box-shadow:
    0 0 3px rgba(255, 255, 255, 0.9),
    0 0 8px rgba(248, 62, 62, 0.9),
    0 0 16px rgba(248, 62, 62, 0.5);
  pointer-events: none;
  opacity: 0;
}

/* ─── Custom scrollbar ─────────────────────────────────────────────────────── */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: #000;
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #7c0000, #3e0000);
  border-radius: 9999px;
  border: 2px solid #000;
}
::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #f83e3e, #7c0000);
}

/* ─── Glow text ────────────────────────────────────────────────────────────── */
.glow-text {
  text-shadow:
    0 0 30px rgba(248, 62, 62, 0.3),
    0 0 80px rgba(248, 124, 124, 0.15);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
